# ============================================================================
# OnSite — The Delivery Promise Platform (Team Pyramid)
# Cấu hình Biến Môi Trường (Environment Variables) cho Vercel & Local
# ============================================================================

# GEMINI_API_KEY: Dán Gemini API Key (bắt đầu bằng AIza...) vào đây hoặc vào
# mục Environment Variables trên Dashboard của Vercel:
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Thông số mặc định của hệ thống OnSite Smart Shell
VITE_APP_NAME="OnSite — The Delivery Promise Platform"
VITE_APP_TEAM="Team Pyramid — Netcompany IT Consultant Challenge 2026"
VITE_DEFAULT_LANG="vi"
VITE_SAFETY_BUFFER_DEFAULT="0.10"
VITE_SYNC_SLA_MS="500"
